#!/usr/bin/env bash
set -Eeuo pipefail

readonly SCRIPT_PATH=$(readlink -f -- "${BASH_SOURCE[0]}")
readonly LAB_HOME=${AI267_LAB_HOME:-$(cd -- "$(dirname -- "${SCRIPT_PATH}")" && pwd)}
readonly EXAM_LAB="${LAB_HOME}/exam-lab.sh"

if [[ -z "${KUBECONFIG:-}" && -f "${HOME}/.auth/lab-kubeconfig" ]]; then
  export KUBECONFIG="${HOME}/.auth/lab-kubeconfig"
fi

usage() {
  cat <<'EOF'
AI267 3.3 연습 명령

  ai267 list             문제와 공식 Lab 목록
  ai267 01               Task 01 Lab 시작과 문제 표시
  ai267 start 01         위와 동일
  ai267 inspect 01       리소스 상태 확인
  ai267 grade 01         채점만 수행
  ai267 finish 01        채점 통과 후 공식 Lab 정리
  ai267 reset 01         풀이를 포기하고 공식 Lab 초기화
  ai267 validate         로컬 파일 정적 검증

한 번에 한 문제만 실행합니다.
EOF
}

[[ -x "${EXAM_LAB}" ]] || {
  printf 'AI267 연습 환경을 찾을 수 없습니다: %s\n' "${EXAM_LAB}" >&2
  exit 1
}

command=${1:-help}
case "${command}" in
  help|-h|--help)
    usage
    ;;
  list|validate)
    exec "${EXAM_LAB}" "${command}"
    ;;
  start|inspect|status|grade|finish|reset)
    [[ -n "${2:-}" ]] || { usage; exit 2; }
    exec "${EXAM_LAB}" "${command}" "${@:2}"
    ;;
  [0-9]|0[1-9]|1[0-2])
    exec "${EXAM_LAB}" start "${command}"
    ;;
  *)
    usage
    exit 2
    ;;
esac
